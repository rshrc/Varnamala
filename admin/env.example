# Firebase browser identifiers. Public at runtime, but supplied outside Git.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only Firebase Admin credentials required on Vercel
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional local Firebase CLI bridge; never configure these on Vercel.
FIREBASE_CLI_CLIENT_ID=
FIREBASE_CLI_CLIENT_SECRET=

# Keep false in production. Local development previews the UI without credentials.
ENABLE_DEMO_MODE=false
